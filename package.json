{
  "name": "alice",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "phone": "node scripts/phone.mjs",
    "build": "node scripts/with-app-env.mjs vite build",
    "build:ci": "node scripts/with-app-env.mjs vite build --mode production",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.strict-contracts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:hermes:live": "HERMES_LIVE_REQUIRED=true vitest run src/lib/hermes-contract.test.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "knip --include files,dependencies,unlisted",
    "cycles:check": "madge --circular --extensions ts,tsx src --exclude 'routeTree\\.gen\\.ts'",
    "duplicates:check": "jscpd src --min-lines 12 --min-tokens 80 --threshold 2 --reporters console",
    "design:check": "node scripts/check-design-system.mjs",
    "bundles:check": "node scripts/check-bundle-budgets.mjs",
    "bundle:smoke": "node scripts/smoke-server-bundle.mjs",
    "security:check": "npm audit --audit-level=high",
    "release:verify": "node scripts/verify-release.mjs",
    "check:static": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:contracts && npm test && npm run test:coverage && npm run cycles:check && npm run duplicates:check && npm run design:check && npm run build:ci && npm run bundle:smoke && npm run bundles:check",
    "check": "npm run check:static && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "undici": "^7.29.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^15.15.0",
    "jscpd": "^5.0.16",
    "jsdom": "^27.0.1",
    "knip": "^6.33.0",
    "lightningcss": "^1.28.0",
    "madge": "^8.0.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
