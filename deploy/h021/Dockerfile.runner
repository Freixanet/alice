FROM python:3.11-slim AS wheel
WORKDIR /src
COPY pyproject.toml setup.py ./
COPY alice_secure_runner ./alice_secure_runner
RUN python -m pip wheel --no-deps -w /dist .

# Real Chromium, ONLY in Alice-owned runner container, not Hermes's computer.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv openssl \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/asr-python
COPY --from=wheel /dist /dist
RUN /opt/asr-python/bin/pip install --no-index --find-links=/dist alice-secure-runner-prototype \
    && rm -rf /dist \
    && mkdir -p /opt/h01 /var/lib/h01 \
    && npm install --prefix /opt/h01 --no-save --no-audit --no-fund playwright@1.55.0 \
    && useradd --uid 12001 --create-home --shell /usr/sbin/nologin alice-h01 \
    && chown -R 12001:12001 /var/lib/h01 /home/alice-h01
USER 12001:12001
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp/h01home PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /tmp
CMD ["/opt/asr-python/bin/python", "-m", "alice_secure_runner.h021_host"]
