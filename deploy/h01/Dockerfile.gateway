FROM python:3.11-slim AS wheel
WORKDIR /src
COPY pyproject.toml setup.py ./
COPY alice_secure_runner ./alice_secure_runner
RUN python -m pip wheel --no-deps -w /dist .

FROM python:3.11-slim
COPY --from=wheel /dist /dist
RUN python -m pip install --no-index --find-links=/dist alice-secure-runner-prototype \
    && rm -rf /dist && groupadd -g 12002 alice-h01 \
    && useradd -u 12002 -g 12002 -s /usr/sbin/nologin alice-h01
USER 12002:12002
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
WORKDIR /tmp
CMD ["python", "-m", "alice_secure_runner.h01_gateway"]
