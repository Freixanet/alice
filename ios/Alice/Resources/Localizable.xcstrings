    },
    "Your agents can use it now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes ya pueden usarlo."
          }
        }
      }
    },
    "Your agents see what you connect here. Nothing leaves your own Hermes, and nothing is added to your calendar unless you tap Add.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes ven lo que conectes aquí. Nada sale de tu Hermes, y no se añade nada a tu calendario salvo que toques Añadir."
          }
        }
      }
    },
    "Your agents stop using it. You can connect it again at any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes dejan de usarlo. Puedes volver a conectarlo cuando quieras."
