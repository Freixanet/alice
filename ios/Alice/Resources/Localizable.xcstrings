          }
        }
      }
    },
    "Installing a plugin can download and execute third-party code on the Mac running Hermes. Review the identifier/source before continuing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar un plugin puede descargar y ejecutar código de terceros en el Mac que ejecuta Hermes. Revisa el identificador/origen antes de continuar."
          }
        }
      }
    },
