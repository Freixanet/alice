      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear cuenta"
          }
        }
      }
    },
    "I don't have an account on %@: create it with the email and password I just gave. Ask me in the chat for anything else the form needs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tengo cuenta en %@: créala con el email y la contraseña que te acabo de dar. Pregúntame en el chat lo que falte del formulario."
          }
        }
      }
