        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la configuración inicial"
          }
        }
      }
    },
    "Choose how Alice checks your watches in Notification setup before starting one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de activar una vigilancia, configura cómo se comprueban las novedades en Configuración de avisos."
