            "value": "Alice y tus agentes"
          }
        }
      }
    },
    "Alice and your agents will run commands, change files and use your accounts without asking first, including risky actions. Send /yolo again to turn it off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice y tus agentes ejecutarán comandos, cambiarán archivos y usarán tus cuentas sin preguntarte antes, incluidas las acciones arriesgadas. Envía /yolo otra vez para desactivarlo."
          }
        }
      }
    },
    "Alice can use this browser": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice puede usar este navegador"
          }
        }
      }
    },
    "Alice cannot reach the dashboard. It only listens on your own network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice no llega a tu Mac. Solo responde en tu propia red o por Tailscale."
          }
