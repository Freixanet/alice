          }
        }
      }
    },
    "The test couldn’t finish checking every item. Nothing was sent. Ask Alice in chat to review this watch.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba no ha podido comprobar todos los elementos. No se ha enviado ningún aviso. Pídele a Alice en el chat que revise esta vigilancia."
          }
        }
      }
    },
    "Items checked: %lld. Alerts Alice would send: %lld. Items still undecided: %lld. Nothing was sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
