    "Nothing matches “%@”. Search covers the chats on this phone and Alice’s screens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada coincide con «%@». La búsqueda abarca los chats de este teléfono y las pantallas de Alice."
          }
        }
      }
    },
    "Nothing new yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay novedades"
          }
        }
      }
    },
    "Agent actions, routine runs and alerts Alice sees will appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán las acciones de los agentes, las ejecuciones de rutinas y los avisos que Alice detecte."
          }
        }
      }
    },
    "feed.seed.feed.kicker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu feed"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.feed.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your feed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es tu feed"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.feed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice writes these posts for you, fresh each time: one idea per post, with every fact linked to where she found it. Tap the page icon at the top to tell her what to cover, the tone you like and what to leave out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice escribe estos posts para ti, nuevos cada vez: una idea por post, con cada dato enlazado a dónde lo encontró. Toca el icono de la página arriba para decirle qué cubrir, el tono que te gusta y qué dejar fuera."
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.chat.kicker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.chat.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One chat for everything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat para todo"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.chat.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Alice anything in her chat. When a conversation has run its course, type /new: the chat starts empty and the old one is kept under Sessions in the side menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a Alice lo que sea en su chat. Cuando una conversación se agote, escribe /new: el chat empieza vacío y el anterior se guarda en Sesiones, en el menú lateral."
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.agents.kicker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.agents.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents and their routines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes y sus rutinas"
          }
        }
      },
      "extractionState": "manual"
    },
    "e.g. every morning at 8 tell me the weather in Blanes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., cada mañana a las 8 dime el tiempo en Blanes"
          }
        }
      }
    },
    "feed.seed.agents.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents are specialists that work for you on a schedule. When one of their routines runs, a card appears in Alice's chat; tap it to see the routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes son especialistas que trabajan para ti con un horario. Cuando una de sus rutinas se ejecuta, aparece una tarjeta en el chat de Alice; tócala para ver la rutina."
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.errands.kicker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errands"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recados"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.errands.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errands, right in the chat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recados, en el propio chat"
          }
        }
      },
      "extractionState": "manual"
    },
    "feed.seed.errands.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Alice to buy or book something and she runs it on her own, apart from the chat. Its progress, questions and payment approval show up as cards in the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a Alice que compre o reserve algo y lo hará por su cuenta, aparte del chat. Su progreso, sus preguntas y la aprobación del pago aparecen como tarjetas en la conversación."
