    "Hugging Face results are outside Hermes' curated catalog. Fit is estimated from file size before download and refined from the GGUF after staging.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de Hugging Face están fuera del catálogo curado de Hermes. El ajuste se estima por tamaño de archivo antes de descargar y se refina con el GGUF tras el staging."
          }
        }
      }
    },
