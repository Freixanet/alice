    "Hooks can execute arbitrary host commands on Hermes lifecycle events. Approved hooks run automatically on matching events.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks pueden ejecutar comandos arbitrarios del host en eventos del ciclo de vida de Hermes. Los hooks aprobados se ejecutan automáticamente en los eventos coincidentes."
          }
        }
      }
