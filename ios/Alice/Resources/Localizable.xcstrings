    },
    "Notification setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración de avisos"
          }
        }
      }
    },
    "Your Hermes must stay on to check for updates. Alerts while Alice is closed use your configured phone notifications.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Hermes debe permanecer encendido para comprobar las novedades. Los avisos con Alice cerrada dependen de las notificaciones que tengas configuradas en el teléfono."
          }
        }
      }
    },
