            "state": "translated",
            "value": "Claves de API"
          }
        }
      }
    },
    "API keys are write-only. Alice sends a new value directly to Hermes and never saves it in local preferences. Leaving the field blank while editing preserves the existing key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API son de solo escritura. Alice envía el valor nuevo directamente a Hermes y nunca lo guarda en preferencias locales. Si dejas el campo en blanco al editar, se conserva la clave existente."
          }
        }
      }
    },
