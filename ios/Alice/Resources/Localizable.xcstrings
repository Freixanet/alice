    "Choose the email and password. Alice fills in the rest of the form and asks you for what is missing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el email y la contraseña. Alice rellena el resto del formulario y te pregunta lo que falte."
          }
        }
      }
    },
    "Alice needs your account to continue. No account? Choose “Create one”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice necesita tu cuenta para seguir. ¿No tienes? Elige «Crear una»."
          }
        }
      }
    },
