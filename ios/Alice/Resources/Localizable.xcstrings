          "stringUnit": {
            "state": "translated",
            "value": "Tus vigilancias"
          }
        }
      }
    },
    "No watches yet. Create your first one in chat.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes vigilancias. Crea la primera hablando con Alice en el chat."
