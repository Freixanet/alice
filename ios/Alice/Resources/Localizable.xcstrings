    "If nothing is staged, Hermes stages every current change before committing. Stage individual files first when you want a partial commit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no hay nada en staging, Hermes prepara todos los cambios actuales antes del commit. Prepara archivos individuales primero cuando quieras un commit parcial."
          }
        }
      }
    },
    "If the Alice plugin is on your Hermes dashboard, show a pairing QR and scan it here. Chat still works from the address and key above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el complemento Alice está en el panel de Hermes, muestra un QR de emparejamiento y escanéalo aquí. El chat también funciona con la dirección y la clave de arriba."
          }
        }
      }
    },
