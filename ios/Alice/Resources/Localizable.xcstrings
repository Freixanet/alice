    },
    "Experimental adds a glass menu above the Home composer. Switch back anytime; chats and drafts stay the same. Available only while developer mode is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La interfaz experimental añade un menú de cristal encima del campo de mensaje en Inicio. Puedes volver cuando quieras; los chats y borradores se conservan. Solo está disponible con el modo desarrollador activado."
          }
        }
      }
    },
