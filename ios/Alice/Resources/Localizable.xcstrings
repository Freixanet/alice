    "Needs setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta configurar"
          }
        }
      }
    },
    "This watch doesn’t say which emails to check. Ask Alice in chat to add the sender or topic before starting it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vigilancia no indica qué correos debe revisar. Pídele a Alice en el chat que añada el remitente o el tema antes de activarla."
          }
        }
      }
    },
    "This watch has no alert rule yet. Ask Alice in chat to finish setting it up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vigilancia aún no tiene una regla para avisarte. Pídele a Alice en el chat que termine de configurarla."
          }
        }
      }
    },
    "The model used to check your watches isn’t ready. Review Notification setup. Your watch has not been started.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo que comprueba tus vigilancias no está listo. Revisa Configuración de avisos. La vigilancia no se ha activado."
          }
        }
      }
    },
    "Alice couldn’t read your email. Check that Gmail is connected to Hermes, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice no ha podido leer tu correo. Comprueba que Gmail esté conectado a Hermes y vuelve a intentarlo."
          }
        }
      }
    },
    "Alice couldn’t apply this change. Ask her in chat to review this watch’s setup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alice no ha podido aplicar el cambio. Pídele en el chat que revise la configuración de esta vigilancia."
          }
        }
      }
    },
    "Your Hermes couldn’t complete this change. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Hermes no ha podido completar el cambio. Vuelve a intentarlo en un momento."
