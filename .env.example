# Cifra la cookie de conexión en el servidor.
# Genera un valor largo y aleatorio. No lo subas al repositorio.
HERMES_COOKIE_SECRET=

# Producción (Vercel + Neon). No subas valores reales.
# DATABASE_URL=
# BETTER_AUTH_URL=https://tu-app.vercel.app
# BETTER_AUTH_SECRET=
# VITE_AUTH_ENABLED=true

# Quién es el dueño del Hermes de esta máquina.
# Si lo dejas vacío, manda la primera cuenta que se registre aquí.
# ALICE_OWNER_EMAIL=tu@correo.com
# ALICE_OWNER_NAME=Tu nombre
# Contraseña para entrar sin Google (mínimo 8 caracteres), útil desde el móvil.
# ALICE_OWNER_PASSWORD=

# Inicio de sesión con Google (opcional).
# Registra la redirect URI: <tu-url>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
