# Cifra la cookie de conexión en el servidor.
# Genera un valor largo y aleatorio. No lo subas al repositorio.
HERMES_COOKIE_SECRET=
# Rotación: lista id:secreto separada por comas; la primera clave cifra y todas descifran.
# HERMES_COOKIE_KEYS=
# Archivo de clave persistente solo para desarrollo sin secretos configurados.
# ALICE_DEV_CREDENTIAL_KEY_FILE=

# Producción (Vercel + Neon). No subas valores reales.
# Conexión PostgreSQL; sin ella se usa PGlite en desarrollo.
# DATABASE_URL=
# Origen público de Better Auth, sin ruta.
# BETTER_AUTH_URL=https://tu-app.vercel.app
# Secreto de Better Auth (al menos 32 caracteres en producción).
# BETTER_AUTH_SECRET=
# Usa false para desactivar autenticación solo en desarrollo.
# VITE_AUTH_ENABLED=true

# Quién es el dueño del Hermes de esta máquina.
# ALICE_OWNER_EMAIL=tu@correo.com
# Sin esta variable no hay propietario: nadie manda sobre el Hermes de esta
# maquina. La cuenta con esa direccion tiene que existir y estar verificada.
#
# Solo para preparar una maquina nueva: promueve la unica cuenta @local.test
# que haya a la direccion de arriba. No lo dejes puesto.
# ALICE_OWNER_CLAIM_LOCAL=1
# Nombre visible de la cuenta propietaria.
# ALICE_OWNER_NAME=Tu nombre
# Contraseña para entrar sin Google (mínimo 8 caracteres), útil desde el móvil.
# ALICE_OWNER_PASSWORD=

# Inicio de sesión con Google (opcional).
# Registra la redirect URI: <tu-url>/api/auth/callback/google
# ID OAuth de Google.
# GOOGLE_CLIENT_ID=
# Secreto OAuth de Google.
# GOOGLE_CLIENT_SECRET=

# Inicio de sesión con Apple (opcional).
# ID de servicio OAuth de Apple.
# APPLE_CLIENT_ID=
# JWT de Apple ya firmado; alternativa a TEAM_ID + KEY_ID + PRIVATE_KEY.
# APPLE_CLIENT_SECRET=
# Equipo de Apple usado para firmar el JWT.
# APPLE_TEAM_ID=
# ID de la clave de firma de Apple.
# APPLE_KEY_ID=
# Clave privada PKCS8 de Apple; acepta saltos de línea escapados como \n.
# APPLE_PRIVATE_KEY=
# Bundle ID permitido para el inicio de sesión nativo de Apple.
# APPLE_APP_BUNDLE_IDENTIFIER=

# Desarrollo local y Hermes.
# Directorio de datos Hermes (por defecto ~/.hermes), también usado por el notificador.
# HERMES_HOME=
# Checkout de hermes-agent usado por el plugin.
# HERMES_AGENT=
# Ejecutable Hermes usado por el plugin.
# HERMES_BIN=
# Clave de la API del gateway leída del .env del perfil Hermes.
# API_SERVER_KEY=
# Puerto de la API del gateway leído del .env del perfil Hermes.
# API_SERVER_PORT=
# Host de la API del gateway leído del .env del perfil Hermes.
# API_SERVER_HOST=
# Usuario Basic Auth del dashboard Hermes, leído con preferencia por su .env.
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# Contraseña Basic Auth del dashboard Hermes.
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Usa 1 para permitir el Hermes local; false o 0 lo desactivan.
# ALICE_LOCAL_HERMES=
# Host Tailscale anunciado al teléfono (detección automática si se omite).
# ALICE_TAILNET_HOST=
# Directorio persistente de PGlite cuando no se usa DATABASE_URL.
# ALICE_PGLITE_DIR=
# Usa 1 para PGlite en memoria; npm run dev lo activa si no hay configuración explícita.
# ALICE_PGLITE_MEMORY=
# Usa 1 para habilitar telemetría operativa también fuera de producción.
# ALICE_TELEMETRY_ENABLED=
# Host público que usa el plugin PWA durante la compilación.
# VITE_PUBLIC_HOSTNAME=

# Plugin y agentes auxiliares (configurar en su entorno, no solo en el .env web).
# Clave opcional de Exa para las búsquedas web del plugin.
# EXA_API_KEY=
# Nombre del browser harness usado para aislar el contexto de un encargo.
# BU_NAME=
# Token de sesión de Twitter usado por el agente internet junto con TWITTER_CT0.
# TWITTER_AUTH_TOKEN=
# Token CSRF de Twitter usado por el agente internet.
# TWITTER_CT0=
# Directorio Hermes que evalúa el agente evals.
# EVALS_HERMES_HOME=
# Directorio de resultados de evals.
# EVALS_DIR=
# Ejecutable Hermes que invoca evals.
# EVALS_HERMES_BIN=
# Conversión EUR por USD usada para calcular costes de evals.
# EVALS_EUR_POR_USD=

# Servidor MCP de Cobalt (entorno de su proceso).
# URL de la API Cobalt.
# COBALT_API_URL=
# Clave de la API Cobalt, si el servidor la requiere.
# COBALT_API_KEY=
# Directorio opcional para guardar descargas de Cobalt.
# COBALT_SAVE_DIR=
# Máximo de opciones del selector Cobalt.
# COBALT_PICKER_MAX=

# Metadatos de despliegue (Vercel inyecta sus variables automáticamente).
# Modo Node; production exige configuración segura y cookies Secure.
# NODE_ENV=
# import.meta.env.DEV lo genera Vite según el modo; no se configura en .env.
# Indicador de ejecución en Vercel; normalmente 1.
# VERCEL=
# Entorno Vercel: production, preview o development.
# VERCEL_ENV=
# SHA del commit desplegado usado como versión pública.
# VERCEL_GIT_COMMIT_SHA=
# Host de producción permitido por Better Auth.
# VERCEL_PROJECT_PRODUCTION_URL=
# Host del despliegue permitido por Better Auth.
# VERCEL_URL=
# Host de la rama permitido por Better Auth.
# VERCEL_BRANCH_URL=
# Versión pública local si no hay SHA de Vercel.
# ALICE_VERSION=

# Verificación y herramientas (exportar en la shell que ejecuta los scripts).
# URL que comprueba npm run release:verify.
# ALICE_DEPLOYMENT_URL=
# SHA esperado por el verificador de despliegue.
# ALICE_EXPECTED_SHA=
# Puerto local de Playwright (1024–65535).
# ALICE_E2E_PORT=
# URL del Hermes de pruebas para el contrato en vivo, nunca el Hermes personal.
# HERMES_LIVE_URL=
# Clave del Hermes de pruebas para el contrato en vivo.
# HERMES_LIVE_KEY=
# Usa true para exigir que se ejecute el contrato en vivo.
# HERMES_LIVE_REQUIRED=
# Usa 1 para permitir hosts externos en scripts de navegador; omitir mantiene la protección.
# BROWSER_ALLOW_EXTERNAL_HOST=
# Python del virtualenv oficial Hermes para scripts/ci-local.sh.
# ALICE_HERMES_TEST_PYTHON=
# Directorio de NVM que puede cargar scripts/ci-local.sh.
# NVM_DIR=
# Directorio node_modules con qrcode@1.5.4 para compilar el dashboard del plugin.
# QR_NODE_MODULES=
# Ejecutable esbuild alternativo para compilar el dashboard del plugin.
# ESBUILD=
# Omite la puerta pre-push si se define; dejar sin definir para ejecutar los controles.
# SKIP_CI=

# Solo fixtures de pruebas; no configurar en producción.
# Simula autenticación en el ejecutable Hermes falso.
# ALICE_FAKE_AUTH=
# Simula un fallo después de emitir salida en el Hermes falso.
# ALICE_FAKE_FAIL_AFTER=
# Simula un fallo al renombrar una sesión en el Hermes falso.
# ALICE_FAKE_RENAME_FAIL=
# Directorio del inbox que recibe el subproceso del plugin y su fixture.
# INBOX_STORE=
